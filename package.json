{
	"name": "xway",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "XDG_CONFIG_HOME=$(pwd) wrangler deploy",
		"dev": "XDG_CONFIG_HOME=$(pwd) wrangler dev --local --inspector-port=8888",
		"start": "XDG_CONFIG_HOME=$(pwd) wrangler dev --local",
		"test": "XDG_CONFIG_HOME=$(pwd) vitest",
		"cf-typegen": "XDG_CONFIG_HOME=$(pwd) wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.10",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.51.0"
	}
}
